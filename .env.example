# ==========================================
# Kraven Environment Variables Configuration
# ==========================================

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
# PostgreSQL connection string (supports Neon, Supabase, Vercel Postgres, AWS RDS, Railway, Render, etc.)
# For pooled connections (e.g. Neon PgBouncer / Supabase Pooler), append ?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/kraven"

# ------------------------------------------
# Application
# ------------------------------------------
# Base URL for the app (used in server-side callbacks and x402 endpoints)
# In production on Vercel, set this to your deployed domain (e.g. https://your-project.vercel.app)
APP_BASE_URL="http://localhost:3000"

# ------------------------------------------
# AI Models (Google Gemini)
# ------------------------------------------
# Required for orchestrator, workers, and prompt optimization
GOOGLE_GENERATIVE_AI_API_KEY=""

# ------------------------------------------
# Prompt Optimizer
# ------------------------------------------
# Toggle local vs Gemini optimizer. When running in serverless (e.g. Vercel),
# set PROMPT_MODEL_ENABLED="false" so it automatically uses Gemini instead of local GGUF.
PROMPT_MODEL_ENABLED="true"

# Optional path to local GGUF model (defaults to models/qwen3-0.6b.gguf)
# PROMPT_MODEL_PATH="./models/qwen3-0.6b.gguf"

# ------------------------------------------
# Web Scraping / Live Research
# ------------------------------------------
# Optional Bright Data Scraping Browser CDP WebSocket URL (e.g., wss://brd-customer-...@brd.superproxy.io:9222)
# If left empty, scraper automatically falls back to direct DuckDuckGo/fetch calls with no credentials needed.
BRIGHTDATA_BROWSER_WS=""

# ------------------------------------------
# Blockchain / Algorand (Optional for Testnet x402 on-chain settlement)
# ------------------------------------------
# ALGOD_SERVER="https://testnet-api.algonode.cloud"
# ALGOD_TOKEN=""
# ALGOD_NETWORK="testnet"
# MANAGER_MNEMONIC="25 word algorand mnemonic for manager wallet"
# SERVICE_ADDRESS="ALGORAND_RECEIVER_ADDRESS"
# MANAGER_ADDRESS="ALGORAND_SENDER_ADDRESS"

# ------------------------------------------
# Firebase Auth (Optional)
# ------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MSG_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
